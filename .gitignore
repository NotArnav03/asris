# ─── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual Environments ────────────────────
venv/
.venv/
env/

# ─── Data (large files) ─────────────────────
# Ignore the contents of data/ but NOT the directory itself, so we can
# whitelist the name-classifier corpus below.  The negation rule cannot
# re-include a path whose parent directory has been excluded, so we use
# `data/*` (children) rather than `data/` (the directory).
data/*

# Reproducibility manifest is regenerated on every `python reproduce.py`
# run; the timestamp fields churn constantly.  Hashes inside are
# inspectable on demand via `python reproduce.py --check`.
reproducibility_manifest.json

# Benchmark dataset caches (downloaded on demand by the load scripts;
# do NOT re-distribute through this repo).  Result JSONs ARE committed
# so reviewers can see the reference numbers without re-running.
benchmarks/*/_cache/
*.csv
*.pkl
*.npy
*.npz
*.h5
*.hdf5

# Whitelist the name-classifier training corpus and its tools.
# These files are part of the fairness audit and must be reproducible.
!data/names/
!data/names/*.py
!data/names/*.md
!data/names/*.txt
!data/names/firstnames_raw.csv
!data/names/training_corpus.csv
!data/names/us_surnames_raw.csv
!data/names/surnames.csv
!data/names/surname_holdout.csv
!data/names/nicknames.csv

# Whitelist the trained name-classifier artifact (small pickle + JSON).
!fairness/names/model.pkl
!fairness/names/model_card.json

# Never commit the recalibrator-fitter backup of the prior pickle.
fairness/names/*.pkl.bak

# ─── Model Files & Caches ───────────────────
*.pt
*.pth
*.onnx
*.bin
*.safetensors
cache/

# Whitelist the SSA char-LSTM plugin weights and meta (must come
# AFTER *.pt so the re-include actually takes effect).
!faimr_plus/ssa_char_lstm/weights.pt
!faimr_plus/ssa_char_lstm/meta.json
.cache/
embedding_cache/

# ─── MLflow / Experiments ────────────────────
mlruns/
mlflow.db
experiments/*.json

# ─── IDE / Editor ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS Files ────────────────────────────────
desktop.ini
*.lnk

# ─── Jupyter ─────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Logs ────────────────────────────────────
*.log
logs/

# ─── Misc ────────────────────────────────────
.env
.env.local
*.bak
